---
import SourceLibrary from '../../components/SourceLibrary.astro';
import Comparisons from '../../components/Comparisons.astro';
import EditorialZh from '../../content/editorial.zh.mdx';
import EditorialEn from '../../content/editorial.en.mdx';
import {glossary} from '../../data/glossary.mjs';
import Shell from '../../layouts/Shell.astro';
import Article from '../../components/Article.astro';
import LongArticle from '../../components/LongArticle.astro';
import {fallacies,guides,cases,allUnits,chapters,paths,findUnit} from '../../data/catalog.mjs';
import {categories} from '../../data/model.mjs';
import {labels} from '../../data/i18n.mjs';

export function getStaticPaths(){return ['zh','en'].flatMap(lang=>[
...[undefined,'knowledge','fallacies','cases','learn','sources','search','editorial','compare','glossary'].map(route=>({params:{lang,route}})),
...Object.keys(categories).map(c=>({params:{lang,route:`fallacies/${c}`}})),
...allUnits.flatMap(e=>['wiki','bilingual'].map(v=>({params:{lang,route:`${v}/${e.id}`}})))
]);}
const lang=Astro.params.lang as 'zh'|'en';const route=Astro.params.route||'';const [type,id]=route.split('/');const l=labels[lang];const entry=(type==='wiki'||type==='bilingual')?findUnit(id):null;
const active=entry?(entry.kind==='guide'?'knowledge':entry.kind==='case'?'cases':'fallacies'):(type||'home');
const title=entry?entry.title[lang]:l[active as keyof typeof l]||'Logic Wiki';
const isBilingual=type==='bilingual';
---
<Shell lang={lang} title={title} active={active} wide={isBilingual}>
{entry ? ('examples' in entry?<Article entry={entry} lang={lang} bilingual={isBilingual}/>:<LongArticle entry={entry} lang={lang} bilingual={isBilingual}/>) : !type ? <>
<div class="home-intro"><h1>{lang==='zh'?'把道理，想明白。':'Think it through.'}</h1><p>{lang==='zh'?'从论证的基本结构，到日常推理中的隐蔽错误。':'From the structure of an argument to the errors hidden in everyday reasoning.'}</p></div>
<div class="home-columns"><section class="chapters"><h2>{lang==='zh'?'探索逻辑学':'Explore logic'}</h2>{chapters.map((c,i)=><a class="chapter-row" href={`/${lang}/knowledge/#${c[0]}`}><span class="chapter-number">{String(i+1).padStart(2,'0')}</span><div><h3>{c[lang==='zh'?1:2]}</h3><p>{c[lang==='zh'?3:4]}</p></div><span class="arrow">→</span></a>)}</section><section class="feature"><h2>{lang==='zh'?'逻辑谬误研习':'A closer look at fallacies'}</h2><h3>{lang==='zh'?'地面湿了，就一定下过雨吗？':'The ground is wet. Must it have rained?'}</h3><p>{lang==='zh'?'如果下雨，地面就会湿。现在地面湿了，所以一定下过雨。':'If it rains, the ground gets wet. The ground is wet, so it must have rained.'}</p><div class="argument-preview" aria-label={lang==='zh'?'两条前提共同指向声称的结论':'Two premises offered for the claimed conclusion'}><div class="premise-stack"><div class="argument-box"><small>{lang==='zh'?'前提 1':'Premise 1'}</small>P → Q</div><div class="argument-box"><small>{lang==='zh'?'前提 2':'Premise 2'}</small>Q</div></div><div class="claim-arrow" aria-hidden="true">⇢</div><div class="argument-box"><small>{lang==='zh'?'声称的结论':'Claimed conclusion'}</small>P</div></div><p>{lang==='zh'?'这是肯定后件：前提可能为真，结论却不一定为真。洒水也能让地面变湿。':'This affirms the consequent. The premises can be true while the conclusion is false: a sprinkler could have wet the ground.'}</p><a class="button" href={`/${lang}/wiki/affirming-consequent/`}>{lang==='zh'?'学习如何辨别':'Learn to tell the difference'} <span>→</span></a></section></div>
<div class="question-band">{[['ad-hominem','人身攻击，还是合理质疑？','A personal attack, or a relevant challenge?','检查个人信息是否与证据相关。','Ask whether the personal information bears on the evidence.'],['hasty-generalization','样本能说明多大范围？','How far can a sample take us?','把观察范围与结论范围对照。','Compare what was observed with what is claimed.'],['slippery-slope','滑坡推理，何时有根据？','When is a slippery slope warranted?','逐环检查机制、证据与阻断条件。','Examine the mechanism, evidence, and safeguards at each step.']].map(x=><a href={`/${lang}/wiki/${x[0]}/`}><h3>{x[lang==='zh'?1:2]} ↗</h3><p>{x[lang==='zh'?3:4]}</p></a>)}</div>
</> : type==='fallacies' ? <>
<header class="index-heading"><h1>{l.fallacies}</h1><p>{lang==='zh'?`${fallacies.length} 个词条，从推理结构、证据和语境辨别问题。分类是学习入口；同一论证可能有多种缺陷。`:`${fallacies.length} entries examine form, evidence, and context. The categories are ways in; an argument can have more than one fault.`}</p></header><nav class="filters" aria-label={lang==='zh'?'按问题分类':'Filter by category'}><a class:list={{selected:!id}} href={`/${lang}/fallacies/`}>{l.all}</a>{Object.entries(categories).map(([key,value])=><a class:list={{selected:id===key}} href={`/${lang}/fallacies/${key}/`}>{value[lang]}</a>)}</nav><div class="entry-list">{fallacies.filter(e=>!id||e.category===id).map((e,i)=><a class="entry-row" href={`/${lang}/wiki/${e.id}/`}><span class="number">{String(i+1).padStart(2,'0')}</span><div><h2>{e.title[lang]}</h2><p>{e.definition[lang]}</p></div><span class="arrow">→</span></a>)}</div>
</> : type==='knowledge' ? <><header class="index-heading"><h1>{l.knowledge}</h1><p>{lang==='zh'?'从前提与结论开始，逐步进入形式系统、证据与逻辑的历史。':'Begin with premises and conclusions, then move into formal systems, evidence, and the history of logic.'}</p></header>{chapters.map(c=><section class="path" id={c[0]}><h2>{c[lang==='zh'?1:2]}</h2><p class="small">{c[lang==='zh'?3:4]}</p><div>{guides.filter((e:any)=>e.chapter===c[0]).map((e:any)=><a class="entry-row" href={`/${lang}/wiki/${e.id}/`}><span class="number">·</span><div><h2>{e.title[lang]}</h2><p>{e.lead[lang]}</p></div><span>→</span></a>)}</div></section>)}</> : type==='cases' ? <><header class="index-heading"><h1>{l.cases}</h1><p>{lang==='zh'?'回到原始材料，区分公开主张、证据与我们的分析。并非每个案例都是谬误：有些展示如何修正判断。':'Return to primary materials and separate public claims, evidence, and our analysis. Some cases show errors; others show how judgments can be corrected.'}</p></header><div class="entry-list">{cases.map((e:any,i:number)=><a class="entry-row" href={`/${lang}/wiki/${e.id}/`}><span class="number">{String(i+1).padStart(2,'0')}</span><div><h2>{e.title[lang]}</h2><p>{e.lead[lang]}</p></div><span>→</span></a>)}</div></> : type==='learn' ? <><header class="index-heading"><h1>{l.learn}</h1><p>{lang==='zh'?'可以按顺序学习，也可以从遇到的具体问题进入。':'Follow a sequence, or start with the question in front of you.'}</p></header>{paths.map(p=><section class="path"><h2>{p.title[lang]}</h2><p>{p.description[lang]}</p><ol>{p.ids.map(id=>{const e=findUnit(id);return e&&<li><a href={`/${lang}/wiki/${id}/`}>{e.title[lang]}</a></li>})}</ol></section>)}</> : type==='sources' ? <SourceLibrary lang={lang}/> : type==='compare' ? <><header class="index-heading"><h1>{lang==='zh'?'辨别与对照':'Distinctions and comparisons'}</h1></header><Comparisons lang={lang}/></> : type==='glossary' ? <><header class="index-heading"><h1>{lang==='zh'?'中英术语表':'Bilingual glossary'}</h1></header>{glossary.map(t=><section class="source-card"><h2>{t[1]} · {t[0]}</h2><p>{t[lang==='zh'?3:2]}</p></section>)}</> : type==='editorial' ? <><header class="index-heading"><h1>{lang==='zh'?'编辑方法与来源':'Editorial methods and sources'}</h1></header><article class="reading-body">{lang==='zh'?<EditorialZh/>:<EditorialEn/>}</article></> : type==='search' ? <><header class="index-heading"><h1>{l.results}</h1></header><div class="search-area"><form role="search"><label class="sr-only" for="q">{l.search}</label><input id="q" type="search" name="q" placeholder={l.search} autocomplete="off" autofocus/><div class="search-options"><label>{lang==='zh'?'范围':'Scope'} <select id="scope"><option value="all">{l.all}</option><option value="fallacy">{l.fallacies}</option><option value="guide">{l.knowledge}</option><option value="case">{l.cases}</option></select></label><button type="submit">{lang==='zh'?'搜索':'Search'}</button><button type="reset">{l.clear}</button></div></form><p class="search-status" aria-live="polite"></p><div id="search-results"></div></div><script is:inline define:vars={{useIndex:import.meta.env.PROD,searchData:allUnits.map(e=>({id:e.id,kind:e.kind,title:e.title,aliases:e.aliases||[],summary:'definition' in e?e.definition:e.lead})),lang}}>
const input=document.querySelector('#q'),results=document.querySelector('#search-results'),status=document.querySelector('.search-status'),scope=document.querySelector('#scope');let engine;let revision=0;
async function search(){const run=++revision;const query=input.value.trim();const type=scope.value;const url=new URL(location.href);query?url.searchParams.set('q',query):url.searchParams.delete('q');history.replaceState(null,'',url);if(!query){results.replaceChildren();status.textContent=lang==='zh'?'输入中文或英文术语开始查找。':'Enter a term in either language.';return;}
const q=query.toLowerCase();let ids=new Set();try{if(useIndex){engine??=await import('/pagefind/pagefind.js');const found=await engine.search(query);const data=await Promise.all(found.results.map(r=>r.data()));for(const d of data){const match=d.url.match(/\/(?:wiki|bilingual)\/([^/]+)/);if(match)ids.add(match[1])}}}catch{}
if(run!==revision)return;const matches=searchData.filter(e=>(type==='all'||(type==='fallacy'?!['guide','case'].includes(e.kind):e.kind===type))&&(ids.has(e.id)||[e.title.zh,e.title.en,...e.aliases,e.summary.zh,e.summary.en].join(' ').toLowerCase().includes(q)));results.replaceChildren();status.textContent=matches.length?(lang==='zh'?`找到 ${matches.length} 个知识单元`:`${matches.length} knowledge units found`):(lang==='zh'?'没有找到匹配内容。试试英文名称或较短的关键词。':'No matches. Try another name or a shorter term.');for(const e of matches){const a=document.createElement('a');a.className='entry-row';a.href=`/${lang}/wiki/${e.id}/`;const num=document.createElement('span');num.className='number';num.textContent='·';const wrap=document.createElement('div'),h=document.createElement('h2'),p=document.createElement('p'),arrow=document.createElement('span');h.textContent=e.title[lang];p.textContent=e.summary[lang];arrow.textContent='→';wrap.append(h,p);a.append(num,wrap,arrow);results.append(a)}}
let timer;input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(search,180)});scope.addEventListener('change',search);document.querySelector('form').addEventListener('submit',e=>{e.preventDefault();search()});document.querySelector('form').addEventListener('reset',()=>setTimeout(search,0));input.value=new URL(location.href).searchParams.get('q')||'';search();
</script></> : null}
</Shell>
