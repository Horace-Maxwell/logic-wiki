{
  "name": "logic-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/*.test.mjs",
    "content:check": "node scripts/check-content.mjs && node scripts/repository-review.mjs",
    "build": "npm run content:check && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist && node scripts/check-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "review": "node scripts/record-review.mjs",
    "review:repository": "node scripts/repository-review.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "description": "Chinese–English logic knowledge base / 中英双语逻辑学知识库",
  "repository": {
    "type": "git",
    "url": "https://github.com/Horace-Maxwell/logic-wiki.git"
  },
  "homepage": "https://github.com/Horace-Maxwell/logic-wiki#readme",
  "bugs": {
    "url": "https://github.com/Horace-Maxwell/logic-wiki/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "UNLICENSED"
}
